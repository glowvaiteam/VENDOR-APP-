# GlowVAI Vendor Backend — Environment
# Copy to .env and fill values

# Server
PORT=4000
NODE_ENV=development

# Firebase Admin SDK (for push notifications & Firestore)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# JWT (for vendor auth tokens)
JWT_SECRET=change_me_to_32_char_random_string

# Allowed origins (CORS)
CORS_ORIGINS=http://localhost:8081,exp://192.168.x.x:8081
