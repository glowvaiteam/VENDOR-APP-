// ════════════════════════════════════════════════════════════════════════════
// GlowVAI Unified Multi-Vendor Enterprise Schema
// PostgreSQL + Prisma ORM (Strict Foreign Keys, Enums & Performance Indexes)
// ════════════════════════════════════════════════════════════════════════════

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ── ENUMS ────────────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  VENDOR_OWNER
  VENDOR_STAFF
  RIDER
  ADMIN
  SUPERADMIN
}

enum VendorStatus {
  PENDING_KYC
  APPROVED
  SUSPENDED
  REJECTED
}

enum OrderStatus {
  PENDING
  BROADCASTED
  ACCEPTED
  PREPARING
  PACKED
  READY_FOR_PICKUP
  DISPATCHED
  DELIVERED
  CANCELLED
  REJECTED
  TIMEOUT
}

enum PaymentMethod {
  UPI_PHONEPE
  UPI_RAZORPAY
  CREDIT_DEBIT_CARD
  NET_BANKING
  CASH_ON_DELIVERY
  WALLET
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum PayoutStatus {
  QUEUED
  PROCESSING
  PROCESSED
  REVERSED
  FAILED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  ESCALATED_TO_ADMIN
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL_URGENT
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

// ── MODELS ───────────────────────────────────────────────────────────────────

model User {
  id              String           @id @default(uuid())
  phone           String           @unique
  email           String?          @unique
  name            String
  role            UserRole         @default(CUSTOMER)
  avatarUrl       String?
  isActive        boolean          @default(true)
  fcmToken        String?
  
  // Relations
  vendorProfile   Vendor?
  ordersPlaced    Order[]          @relation("CustomerOrders")
  supportTickets  SupportTicket[]  @relation("UserTickets")
  referralEntries ReferralEntry[]  @relation("UserReferrals")
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([phone])
  @@index([role])
}

model Vendor {
  id                  String             @id @default(uuid())
  userId              String             @unique
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Dark Store & Business Identifiers
  storeId             String             @unique // e.g. DS-VIJ-01
  shopName            String
  legalBusinessName   String
  businessType        String             // Retailer, Wholesaler, Supermarket, Dark Store
  gstin               String?            @unique
  panNumber           String?
  
  // Geo & Location
  addressLine1        String
  locality            String
  city                String
  state               String
  pincode             String
  latitude            Float
  longitude           Float
  serviceRadiusKm     Float              @default(7.5)
  
  // Banking & Payout (RazorpayX / PhonePe / Cashfree)
  bankAccountNumber   String?
  bankIfsc            String?
  bankName            String?
  accountHolderName   String?
  upiVpa              String?            // e.g. vendor@okhdfcbank
  razorpayFundAccountId String?
  
  // Operations & Presence
  isOnline            Boolean            @default(false)
  autoAcceptOrders    Boolean            @default(false)
  currentSocketId     String?
  lastActiveAt        DateTime?
  status              VendorStatus       @default(PENDING_KYC)
  kycDocUrl           String?
  fssaiNumber         String?
  
  // Performance & Take-Rate
  rating              Float              @default(5.0)
  totalOrdersCount    Int                @default(0)
  commissionRate      Float              @default(0.12) // 12% Platform take-rate
  walletBalance       Decimal            @default(0.00) @db.Decimal(12, 2)
  pendingPayout       Decimal            @default(0.00) @db.Decimal(12, 2)
  
  // Relations
  inventory           Inventory[]
  ordersAssigned      Order[]            @relation("VendorOrders")
  payoutTransactions  PayoutTransaction[]
  ticketsCreated      SupportTicket[]    @relation("VendorTickets")
  
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([storeId])
  @@index([isOnline])
  @@index([status])
  @@index([city, locality])
}

model Product {
  id                  String             @id @default(uuid())
  sku                 String             @unique // e.g. SKU-NIAC-001
  name                String
  brand               String?
  category            String
  unitType            String             // bottle, tube, pack, piece, kg, g, ml
  packSize            String             // 30 ml, 500 g
  mrp                 Decimal            @db.Decimal(10, 2)
  sellingPrice        Decimal            @db.Decimal(10, 2)
  hsnCode             String?
  gstPercent          Int                @default(18)
  description         String?
  imageUrls           String[]
  isActive            Boolean            @default(true)
  
  inventoryItems      Inventory[]
  orderItems          OrderItem[]
  
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([sku])
  @@index([category])
  @@index([brand])
}

model Inventory {
  id                  String             @id @default(uuid())
  vendorId            String
  vendor              Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  productId           String
  product             Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  // Stock Accounting
  stockOnHand         Int                @default(0) // Physical units on shelf
  reservedStock       Int                @default(0) // Locked during broadcast/checkout
  availableStock      Int                @default(0) // (stockOnHand - reservedStock)
  lowStockThreshold   Int                @default(5)
  binLocation         String?            // e.g. AISLE-A-BIN-04
  isAvailable         Boolean            @default(true)
  
  stockLogs           InventoryAuditLog[]
  
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([vendorId, productId])
  @@index([vendorId])
  @@index([availableStock])
}

model InventoryAuditLog {
  id                  String             @id @default(uuid())
  inventoryId         String
  inventory           Inventory          @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  delta               Int                // +10 or -2
  resultingStock      Int
  reason              String             // 'ORDER_RESERVED', 'ORDER_FULFILLED', 'MANUAL_RESTOCK', 'DAMAGE'
  orderId             String?
  performedBy         String?            // User ID or SYSTEM
  createdAt           DateTime           @default(now())

  @@index([inventoryId])
  @@index([createdAt])
}

model Order {
  id                  String             @id @default(uuid())
  orderNumber         String             @unique // e.g. ORD-982104
  customerId          String
  customer            User               @relation("CustomerOrders", fields: [customerId], references: [id])
  vendorId            String?
  vendor              Vendor?            @relation("VendorOrders", fields: [vendorId], references: [id])
  
  // Delivery Destination
  customerName        String
  customerPhone       String
  deliveryAddress     String
  deliveryLatitude    Float?
  deliveryLongitude   Float?
  
  // Pricing & Payout Splits
  subtotal            Decimal            @db.Decimal(10, 2)
  discountAmount      Decimal            @default(0.00) @db.Decimal(10, 2)
  deliveryFee         Decimal            @default(0.00) @db.Decimal(10, 2)
  grandTotal          Decimal            @db.Decimal(10, 2)
  platformFeePercent  Float              @default(0.12) // 12%
  platformFeeAmount   Decimal            @db.Decimal(10, 2)
  vendorEarnings      Decimal            @db.Decimal(10, 2) // 88% Net
  
  // Status & Lifecycle
  status              OrderStatus        @default(PENDING)
  paymentMethod       PaymentMethod      @default(UPI_RAZORPAY)
  paymentStatus       PaymentStatus      @default(PENDING)
  paymentTxnId        String?
  deliveryOtp         String             // 4-digit handover code
  
  // SLAs & Timestamps
  broadcastExpiresAt  DateTime?
  acceptedAt          DateTime?
  packedAt            DateTime?
  dispatchedAt        DateTime?
  deliveredAt         DateTime?
  cancelledAt         DateTime?
  cancellationReason  String?
  
  // Fleet Rider
  riderName           String?
  riderPhone          String?
  
  // Relations
  items               OrderItem[]
  timelineLogs        OrderTimeline[]
  payoutTransaction   PayoutTransaction?
  
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([orderNumber])
  @@index([status])
  @@index([vendorId])
  @@index([customerId])
  @@index([createdAt])
}

model OrderItem {
  id                  String             @id @default(uuid())
  orderId             String
  order               Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String
  product             Product            @relation(fields: [productId], references: [id])
  quantity            Int
  unitPrice           Decimal            @db.Decimal(10, 2)
  totalPrice          Decimal            @db.Decimal(10, 2)
  
  createdAt           DateTime           @default(now())

  @@index([orderId])
}

model OrderTimeline {
  id                  String             @id @default(uuid())
  orderId             String
  order               Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status              OrderStatus
  title               String
  description         String?
  createdAt           DateTime           @default(now())

  @@index([orderId])
}

model PayoutTransaction {
  id                  String             @id @default(uuid())
  payoutId            String             @unique // e.g. POUT-202610-001
  vendorId            String
  vendor              Vendor             @relation(fields: [vendorId], references: [id])
  orderId             String?            @unique
  order               Order?             @relation(fields: [orderId], references: [id])
  
  amount              Decimal            @db.Decimal(12, 2)
  currency            String             @default("INR")
  gateway             String             @default("RAZORPAYX") // RAZORPAYX, CASHFREE, PHONEPE
  gatewayPayoutId     String?
  fundAccountId       String?
  status              PayoutStatus       @default(QUEUED)
  failureReason       String?
  
  settledAt           DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([vendorId])
  @@index([status])
  @@index([payoutId])
}

model SupportTicket {
  id                  String             @id @default(uuid())
  ticketNumber        String             @unique // e.g. TKT-4892
  userId              String?
  user                User?              @relation("UserTickets", fields: [userId], references: [id])
  vendorId            String?
  vendor              Vendor?            @relation("VendorTickets", fields: [vendorId], references: [id])
  
  subject             String
  description         String
  category            String             // 'ORDER_ISSUE', 'PAYOUT_DISPUTE', 'INVENTORY_MISMATCH', 'APP_BUG'
  priority            TicketPriority     @default(MEDIUM)
  status              TicketStatus       @default(OPEN)
  attachmentUrls      String[]
  adminNotes          String?
  assignedAdminId     String?
  
  resolvedAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([ticketNumber])
  @@index([status])
  @@index([vendorId])
  @@index([priority])
}

model ReferralCampaign {
  id                  String             @id @default(uuid())
  slug                String             @unique // e.g. "glowvai-festive-2026"
  title               String
  description         String?
  sourceRepoUrl       String             @default("https://glowvaiteam.github.io/glowvai-campaign/")
  rewardPerReferral   Decimal            @default(50.00) @db.Decimal(10, 2)
  refereeReward       Decimal            @default(100.00) @db.Decimal(10, 2)
  status              CampaignStatus     @default(ACTIVE)
  
  entries             ReferralEntry[]
  
  startsAt            DateTime?
  endsAt              DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([slug])
  @@index([status])
}

model ReferralEntry {
  id                  String             @id @default(uuid())
  campaignId          String
  campaign            ReferralCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  referrerUserId      String
  referrerUser        User               @relation("UserReferrals", fields: [referrerUserId], references: [id])
  
  referralCode        String             @unique
  clicksCount         Int                @default(0)
  conversionsCount    Int                @default(0)
  totalEarned         Decimal            @default(0.00) @db.Decimal(10, 2)
  
  conversions         ReferralConversion[]
  
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([referralCode])
  @@index([referrerUserId])
}

model ReferralConversion {
  id                  String             @id @default(uuid())
  referralEntryId     String
  referralEntry       ReferralEntry      @relation(fields: [referralEntryId], references: [id], onDelete: Cascade)
  newCustomerPhone    String
  firstOrderId        String?
  rewardPaid          Boolean            @default(false)
  rewardAmount        Decimal            @db.Decimal(10, 2)
  createdAt           DateTime           @default(now())

  @@index([referralEntryId])
}
