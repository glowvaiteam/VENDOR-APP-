# GlowVAI Vendor Mobile — Environment
# Copy to .env and fill values

# Backend API base URL (replace IP with your machine's LAN IP for device testing)
EXPO_PUBLIC_VENDOR_API_URL=http://localhost:4000

# Vendor & Store identifiers (for this vendor's session)
EXPO_PUBLIC_VENDOR_ID=VND-001
EXPO_PUBLIC_STORE_ID=DS-VIJ-01

# Feature flags
EXPO_PUBLIC_ENABLE_SOCKET=true
EXPO_PUBLIC_ORDER_POLL_INTERVAL_MS=2500

# Firebase Web Config
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
